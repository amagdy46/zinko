# Copy to .env for `pnpm dev`. The values below are for local use only; see CONTRIBUTING.md.

# Postgres (docker compose up -d)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Better Auth with organizations. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin. Leave empty locally: Better Auth infers it from each request.
BETTER_AUTH_URL=

# Alchemy: only needed to deploy
CLOUDFLARE_ACCOUNT_ID=

# Effect AI (bring your own key): encrypts saved keys. Generate: openssl rand -base64 32
LLM_ENCRYPTION_KEY=

# Storage: signs download URLs, at least 32 characters. Generate: openssl rand -base64 32
STORAGE_SIGNING_SECRET=

# Email: `console` prints messages to the dev server log
MAIL_FROM=noreply@localhost
MAIL_TRANSPORT=console

# Capture engine started by hand. `dev` stages only; deployed stages ignore it and use the container.
BROWSER_URL=http://localhost:8080
