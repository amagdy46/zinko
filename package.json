{
  "name": "zinko-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev infra/alchemy.run.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p infra",
    "lint": "vp lint",
    "format": "vp fmt",
    "check": "vp check",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "deploy": "alchemy deploy infra/alchemy.run.ts",
    "destroy": "alchemy destroy infra/alchemy.run.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.4.2"
}
