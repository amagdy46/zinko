{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": []
    },
    "web#typecheck": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": ["src/routeTree.gen.ts"]
    }
  }
}
